SESSION_LIFETIME=
# Required in production: the control panel authenticates with a session cookie.
SESSION_SECURE_COOKIE=
# Leave SESSION_DOMAIN unset so the panel cookie stays scoped to cpanel and is
# never shared with the customer host at www.

# ─── Admin control panel (Filament) ───────────────────────────────────
# Host the panel is bound to, e.g. cpanel.potatoaihub.com. Changing this needs
# `php artisan route:clear && php artisan route:cache` — route:cache bakes it in.
ADMIN_PANEL_DOMAIN=
# Optional second layer on top of credentials. Leave empty/false until you have
# added your own IP through the panel, or you will lock yourself out.
ADMIN_PANEL_IP_GATE=
# Break-glass CSV of IPs that bypass the database allowlist entirely.
ADMIN_PANEL_IP_ALLOWLIST=

